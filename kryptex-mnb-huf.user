
// ==UserScript==
// @name         Kryptex – Profitability és Balance forintban (MNB)
// @namespace    local.kryptex.mnb.huf
// @version      1.3.1
// @description  Hardware Profitability és Dashboard Balance HUF-ban, MNB árfolyammal.
// @match        https://www.kryptex.com/site/hardware*
// @match        https://kryptex.com/site/hardware*
// @match        https://www.kryptex.com/site/dashboard*
// @match        https://kryptex.com/site/dashboard*
// @grant        GM_xmlhttpRequest
// @grant        GM_getValue
// @grant        GM_setValue
// @connect      www.mnb.hu
// @run-at       document-idle
// @sandbox      DOM
// @noframes
// ==/UserScript==

(() => {
    'use strict';

    const HOUR = 60 * 60 * 1000;
    const KEY = 'mnb-eur-huf-v1';
    const CLASS = 'kryptex-mnb-huf';

    const format = new Intl.NumberFormat('hu-HU', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });

    const hardwareRows = new Map();
    const dashboardRows = new Map();

    // Állapotjelző
    const status = document.createElement('div');
    status.style.cssText = `
        position:fixed;
        bottom:16px;
        right:16px;
        z-index:2147483647;
        padding:10px 14px;
        border:1px solid #b8c5d8;
        border-radius:8px;
        background:#fff;
        color:#182235;
        font:13px/1.5 system-ui;
        max-width:340px;
        box-shadow:0 2px 12px #0002;
    `;

    status.textContent = 'Kryptex HUF 1.3: elindult…';
    document.documentElement.append(status);

    // Mentett MNB árfolyam betöltése
    let rate = null;

    try {
        rate = GM_getValue(KEY, null);
    } catch (error) {
        console.warn('[Kryptex MNB HUF] Cache hiba:', error);
    }

    if (
        !rate ||
        !Number.isFinite(rate.value) ||
        rate.value <= 0 ||
        !/^\d{4}-\d{2}-\d{2}$/.test(rate.date) ||
        !Number.isFinite(rate.fetchedAt)
    ) {
        rate = null;
    }

    let failed = false;
    let lastError = '';
    let busy = false;
    let nextAttempt = 0;
    let scheduled = false;

    // =====================================================
    // 1. HARDWARE PROFITABILITY – EUR/hó és EUR/nap
    // =====================================================

    function amounts(text) {
        const number =
            '(-?(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d+)?)';

        const match = text
            .replace(/[\u200B-\u200D\uFEFF]/g, '')
            .trim()
            .match(new RegExp(
                '^€\\s*' + number +
                '\\s*/mo\\s*·\\s*€\\s*' +
                number + '\\s*/d$'
            ));

        if (!match) return null;

        const values = match
            .slice(1)
            .map(x => Number(x.replace(/,/g, '')));

        return values.every(Number.isFinite)
            ? values
            : null;
    }

    // =====================================================
    // 2. DASHBOARD BALANCE – EUR összeg
    // Példa: <span class="kx-hero__sub-text">
    //          ≈ €1492.34
    //        </span>
    // =====================================================

    function balanceAmount(text) {
        const cleaned = text
            .replace(/[\u200B-\u200D\uFEFF\u00A0\u202F]/g, '')
            .trim();

        const match = cleaned.match(
            /^≈?\s*€\s*(-?(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?)$/
        );

        if (!match) return null;

        const value = Number(match[1].replace(/,/g, ''));

        return Number.isFinite(value)
            ? value
            : null;
    }

    // =====================================================
    // 3. MNB EUR/HUF középárfolyam feldolgozása
    // =====================================================

    function readRate(text) {
        const doc = new DOMParser()
            .parseFromString(text, 'text/html');

        const months = [
            'január', 'február', 'március', 'április',
            'május', 'június', 'július', 'augusztus',
            'szeptember', 'október', 'november',
            'december'
        ];

        for (const table of doc.querySelectorAll('table')) {
            const caption =
                table.querySelector('caption')?.textContent || '';

            const match = caption.match(
                /Napi árfolyamok:\s*(\d{4})\.\s*([a-záéíóöőúüű]+)\s+(\d{1,2})\./i
            );

            if (!match) continue;

            const month =
                months.indexOf(match[2].toLowerCase()) + 1;

            if (
                !month ||
                Number(match[3]) < 1 ||
                Number(match[3]) > 31
            ) continue;

            const date =
                `${match[1]}-` +
                `${String(month).padStart(2, '0')}-` +
                `${match[3].padStart(2, '0')}`;

            for (const tr of table.querySelectorAll('tr')) {
                const cells = [
                    ...tr.querySelectorAll('td')
                ].map(td => td.textContent.trim());

                if (
                    cells.length !== 4 ||
                    cells[0] !== 'EUR'
                ) continue;

                const unit = Number(cells[2]);

                const value =
                    Number(
                        cells[3]
                            .replace(/\s/g, '')
                            .replace(',', '.')
                    ) / unit;

                if (
                    !Number.isFinite(value) ||
                    value <= 0 ||
                    unit <= 0
                ) {
                    throw new Error('Érvénytelen EUR-árfolyam.');
                }

                return {
                    value,
                    date,
                    fetchedAt: Date.now()
                };
            }
        }

        throw new Error(
            'Az MNB napi táblázata vagy EUR sora nem található.'
        );
    }

    // =====================================================
    // 4. Közös megjelenítési segédfüggvények
    // =====================================================

    function isStale() {
        return rate && (
            failed ||
            Date.now() - rate.fetchedAt > 2 * HOUR
        );
    }

    function rateTitle() {
        if (!rate) {
            return 'Az MNB legutolsó közzétett EUR/HUF árfolyama alapján.';
        }

        return (
            `MNB középárfolyam (${rate.date}): ` +
            `1 EUR = ${format.format(rate.value)} Ft.` +
            (isStale()
                ? ' A mentett árfolyam frissítése esedékes vagy sikertelen.'
                : '')
        );
    }

    function waitingText() {
        return failed
            ? `MNB: ${lastError} Újrapróbálkozás 5 perc múlva.`
            : 'MNB-árfolyam betöltése…';
    }

    function copyStyle(source, row) {
        row.className = `${source.className} ${CLASS}`;

        for (const attr of source.attributes) {
            if (attr.name.startsWith('data-v-')) {
                row.setAttribute(attr.name, attr.value);
            }
        }

        row.style.cssText = source.style.cssText;
    }

    // =====================================================
    // 5. Hardware oldal megjelenítése
    // =====================================================

    function renderHardware() {
        for (const [source, row] of hardwareRows) {
            if (
                !source.isConnected ||
                !source.matches('.hwt-meta') ||
                !amounts(source.textContent)
            ) {
                row.remove();
                hardwareRows.delete(source);
            }
        }

        const sources = document.querySelectorAll(
            `.hwt-meta:not(.${CLASS})`
        );

        for (const source of sources) {
            const values = amounts(source.textContent);

            if (!values) continue;

            let row = hardwareRows.get(source);

            if (!row) {
                row = document.createElement('div');
                copyStyle(source, row);
                hardwareRows.set(source, row);
            }

            if (source.nextElementSibling !== row) {
                source.after(row);
            }

            const text = rate
                ? `${format.format(values[0] * rate.value)} Ft/hó · ` +
                  `${format.format(values[1] * rate.value)} Ft/nap` +
                  (isStale() ? ' ⚠' : '')
                : waitingText();

            if (row.textContent !== text) {
                row.textContent = text;
            }

            const title = rateTitle();

            if (row.title !== title) {
                row.title = title;
            }
        }
    }

    // =====================================================
    // 6. Dashboard főoldal – BALANCE HUF
    // =====================================================


function renderDashboard() {

    // CSS létrehozása egyszer, az első futáskor
    if (!document.getElementById('kryptex-huf-dashboard-style')) {
        const style = document.createElement('style');

        style.id = 'kryptex-huf-dashboard-style';

        style.textContent = `
    .kx-hero__sub-text[data-kryptex-huf] {
        position: relative !important;
        display: inline-block !important;
        white-space: nowrap;
        vertical-align: baseline;
    }

    .kx-hero__sub-text[data-kryptex-huf]::after {
        content: attr(data-kryptex-huf);
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        display: block;
        white-space: nowrap;
    }
`;

        document.head.appendChild(style);
    }

    // Megszűnt vagy megváltozott mezők eltávolítása
    for (const source of dashboardRows.keys()) {
        if (
            !source.isConnected ||
            !source.matches('.kx-hero__sub-text') ||
            balanceAmount(source.textContent) === null
        ) {
            source.removeAttribute('data-kryptex-huf');
            dashboardRows.delete(source);
        }
    }

    // EUR mezők feldolgozása
    const sources = document.querySelectorAll(
        '.kx-hero__sub-text'
    );

    for (const source of sources) {
        const euro = balanceAmount(source.textContent);

        if (euro === null) continue;

        const hufText = rate
            ? `≈ ${format.format(euro * rate.value)} Ft` +
              (isStale() ? ' ⚠' : '')
            : waitingText();

        // A második sort CSS ::after jeleníti meg
        if (
            source.getAttribute('data-kryptex-huf') !== hufText
        ) {
            source.setAttribute(
                'data-kryptex-huf',
                hufText
            );
        }

        const title = rateTitle();

        if (source.title !== title) {
            source.title = title;
        }

        dashboardRows.set(source, true);
    }
}

    // =====================================================
    // 7. Központi render
    // =====================================================

    function render() {
        scheduled = false;

        renderHardware();
        renderDashboard();

        const totalRows =
            hardwareRows.size + dashboardRows.size;

        const message = totalRows
            ? ''
            : 'Kryptex HUF 1.3 fut, de nem található ' +
              'támogatott EUR mező. Ellenőrizd a Dashboard ' +
              'vagy Hardware oldalt és az EUR pénznemet.';

        if (status.textContent !== message) {
            status.textContent = message;
        }

        const display = totalRows
            ? 'none'
            : 'block';

        if (status.style.display !== display) {
            status.style.display = display;
        }
    }

    function schedule() {
        if (!scheduled) {
            scheduled = true;
            setTimeout(render, 100);
        }
    }

    // =====================================================
    // 8. MNB árfolyam frissítése
    // =====================================================

    function refresh() {
        if (
            busy ||
            Date.now() < nextAttempt ||
            (
                rate &&
                Date.now() - rate.fetchedAt < HOUR
            )
        ) return;

        busy = true;

        const failure = error => {
            busy = false;
            failed = true;

            lastError = error instanceof Error
                ? error.message
                : String(error);

            nextAttempt =
                Date.now() + 5 * 60 * 1000;

            console.warn(
                '[Kryptex MNB HUF]',
                error
            );

            schedule();
        };

        try {
            GM_xmlhttpRequest({
                method: 'GET',
                url: 'https://www.mnb.hu/arfolyamok',
                anonymous: true,
                timeout: 20000,

                onload(response) {
                    try {
                        if (response.status !== 200) {
                            throw new Error(
                                `MNB HTTP ${response.status}`
                            );
                        }

                        rate = readRate(
                            response.responseText
                        );

                        try {
                            GM_setValue(KEY, rate);
                        } catch (error) {
                            console.warn(
                                '[Kryptex MNB HUF] Mentési hiba:',
                                error
                            );
                        }

                        busy = false;
                        failed = false;
                        lastError = '';
                        nextAttempt = 0;

                        schedule();

                    } catch (error) {
                        failure(error);
                    }
                },

                onerror: () => failure(
                    'Hálózati hiba vagy hiányzó MNB-hozzáférés.'
                ),

                ontimeout: () => failure(
                    'Az MNB nem válaszolt időben.'
                ),

                onabort: () => failure(
                    'Megszakadt az MNB-lekérdezés.'
                )
            });

        } catch (error) {
            failure(error);
        }
    }

    // =====================================================
    // 9. Dinamikus frissítés és indítás
    // =====================================================

    new MutationObserver(schedule).observe(
        document.body,
        {
            childList: true,
            subtree: true,
            characterData: true
        }
    );

    render();
    refresh();

    // Percenkénti ellenőrzés
    setInterval(() => {
        refresh();
        schedule();
    }, 60 * 1000);

    // Visszatérés böngészőfülre
    document.addEventListener(
        'visibilitychange',
        () => {
            if (!document.hidden) {
                refresh();
                schedule();
            }
        }
    );

})();
